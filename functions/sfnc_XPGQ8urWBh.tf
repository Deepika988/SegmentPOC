  code          = "// Learn more about source functions API at\n// https://segment.com/docs/connections/sources/source-functions\n\n/**\n * Handle incoming HTTP request\n *\n * @param  {FunctionRequest} request\n * @param  {FunctionSettings} settings\n */\nasync function onRequest(request, settings) {\n\tconst eventBody = request.json();\n\tconsole.log('eventBody=' + eventBody);\n\n\tconst endpoint = ''; // replace with your endpoint\n\tlet response;\n\tlet uId = eventBody.userId;\n\n\ttry {\n\t\t//dms starts\n\n\t\tif (eventBody.sourceType == 'CRM') {\n\t\t\tconsole.log(\"eventBody.sourceType == 'CRM'\" + eventBody.sourceType);\n\t\t\tconsole.log('eventBody.userId' + eventBody.userId);\n\t\t\tconsole.log('eventBody.orderAmount' + eventBody.orderAmount);\n\n\t\t\tconst props = {\n\t\t\t\tsource: 'CRM',\n\t\t\t\torderAmount: eventBody.orderAmount\n\t\t\t};\n\t\t\tSegment.set({\n\t\t\t\tcollection: eventBody.sourceType,\n\t\t\t\tid: eventBody.userId,\n\t\t\t\tproperties: props\n\t\t\t});\n\t\t\tSegment.track({\n\t\t\t\tevent: 'Order Completed',\n\t\t\t\tuserId: uId, //eventBody.userId'',\n\t\t\t\tproperties: props\n\t\t\t});\n\n\t\t\t// See https://segment.com/docs/connections/spec/identify/\n\t\t\tSegment.identify({\n\t\t\t\tuserId: uId,\n\t\t\t\ttraits: {\n\t\t\t\t\tuserName: 'sourceFunctionACN',\n\t\t\t\t\torderAmount: eventBody.orderAmount\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\n\t\t//dms ends\n\t} catch (error) {\n\t\t// Retry on connection error\n\t\tthrow new RetryError('There is some error..: ' + error.message);\n\t}\n\n\t/*\tif (response.status >= 500 || response.status === 429) {\n\t\t// Retry on 5xx (server errors) and 429s (rate limits)\n\t\tthrow new RetryError(`Failed with $${response.status}`);\n\t} */\n\n\t// See https://segment.com/docs/connections/spec/track/\n\tSegment.track({\n\t\tevent: 'Test Event',\n\t\tuserId: uId,\n\t\tproperties: {\n\t\t\ttestProperty: 'testValue'\n\t\t\t//\t\ttestProperty2: response.propertyName\n\t\t}\n\t});\n\n\t// See https://segment.com/docs/connections/spec/identify/\n\tSegment.identify({\n\t\tuserId: uId,\n\t\ttraits: {\n\t\t\tuserName: 'sourceFunctionACN'\n\t\t}\n\t});\n\n\t// See https://segment.com/docs/connections/spec/group/\n\tSegment.group({\n\t\tgroupId: 'group_id',\n\t\tuserId: uId,\n\t\ttraits: {\n\t\t\tgroupName: 'Unicorn'\n\t\t}\n\t});\n\n\t// See https://segment.com/docs/connections/spec/page/\n\tSegment.page({\n\t\tname: 'Home page',\n\t\tuserId: uId,\n\t\tproperties: {\n\t\t\turl: 'https://mywebsite.com/about'\n\t\t}\n\t});\n\n\t// See https://segment.com/docs/connections/spec/screen/\n\tSegment.screen({\n\t\tname: 'Test Screen',\n\t\tuserId: uId,\n\t\tproperties: {\n\t\t\turl: 'https://mywebsite.com/about'\n\t\t}\n\t});\n\n\t// See https://segment.com/docs/connections/sources/catalog/libraries/server/object-api/\n\tSegment.set({\n\t\tcollection: 'users',\n\t\tid: uId,\n\t\tproperties: {\n\t\t\tuserName: 'sourceFunctionACN'\n\t\t}\n\t});\n}\n"
